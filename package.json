{
  "name": "@local/computer-use",
  "version": "1.0.1",
  "private": true,
  "license": "MIT",
  "description": "Left-sidebar computer use through a private standard-mode CUA driver. The agent observes windows and operates them until you switch it off.",
  "type": "module",
  "engines": {
    "dsh": ">=0.2.1-rc.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kinfxhk/dsh-computer-use.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "driver/cua-driver.exe"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
